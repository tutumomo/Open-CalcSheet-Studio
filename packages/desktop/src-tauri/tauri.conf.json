{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open CalcSheet Studio TW",
  "version": "2026.46.2",
  "identifier": "tw.opencalcsheet.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3021",
    "beforeBuildCommand": "node ../../scripts/haal-fem-server.mjs --als-nodig && node ../../scripts/bouw-jupyter-omgeving.mjs --als-nodig && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Open CalcSheet Studio TW",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$TEMP/open-calcsheet-studio/**",
          "**/*.pdf"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "deb", "appimage"],
    "fileAssociations": [
      {
        "ext": ["ifccalculation"],
        "name": "Open CalcSheet Studio TW-project",
        "description": "Open CalcSheet Studio TW-project",
        "mimeType": "application/json",
        "role": "Editor"
      }
    ],
    "resources": [
      "WebView2Loader.dll",
      "jupyter-omgeving/*",
      "fem-studio/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
