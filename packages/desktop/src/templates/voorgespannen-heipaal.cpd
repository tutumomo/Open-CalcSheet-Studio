# Ruimtelijk aanzicht
'Blauw is voorspanstaal, rood is kopwapening. De lengteas is tienmaal verkort om de doorsnede leesbaar te houden.
#hide
l_beeld = L/(1 mm)/10
b_beeld = b/(1 mm)
#show
@3d
camera iso
hoogte 300
raster uit
assen uit
staaf 0 0 0 {{b_beeld}} 0 0 grijs
staaf {{b_beeld}} 0 0 {{b_beeld}} {{b_beeld}} 0 grijs
staaf {{b_beeld}} {{b_beeld}} 0 0 {{b_beeld}} 0 grijs
staaf 0 {{b_beeld}} 0 0 0 0 grijs
staaf 0 0 {{l_beeld}} {{b_beeld}} 0 {{l_beeld}} grijs
staaf {{b_beeld}} 0 {{l_beeld}} {{b_beeld}} {{b_beeld}} {{l_beeld}} grijs
staaf {{b_beeld}} {{b_beeld}} {{l_beeld}} 0 {{b_beeld}} {{l_beeld}} grijs
staaf 0 {{b_beeld}} {{l_beeld}} 0 0 {{l_beeld}} grijs
staaf 0 0 0 0 0 {{l_beeld}} grijs
staaf 0 {{b_beeld}} 0 0 {{b_beeld}} {{l_beeld}} grijs
staaf {{b_beeld}} 0 0 {{b_beeld}} 0 {{l_beeld}} grijs
staaf {{b_beeld}} {{b_beeld}} 0 {{b_beeld}} {{b_beeld}} {{l_beeld}} grijs
buis {{d_as}} {{d_as}} 0 {{d_as}} {{d_as}} {{l_beeld}} {{dia_p}} blauw
buis {{d_as}} {{b_beeld-d_as}} 0 {{d_as}} {{b_beeld-d_as}} {{l_beeld}} {{dia_p}} blauw
buis {{b_beeld-d_as}} {{d_as}} 0 {{b_beeld-d_as}} {{d_as}} {{l_beeld}} {{dia_p}} blauw
buis {{b_beeld-d_as}} {{b_beeld-d_as}} 0 {{b_beeld-d_as}} {{b_beeld-d_as}} {{l_beeld}} {{dia_p}} blauw
#if n_p ≡ 5
buis {{b_beeld/2}} {{b_beeld/2}} 0 {{b_beeld/2}} {{b_beeld/2}} {{l_beeld}} {{dia_p}} blauw
#end if
#if n_p ≡ 6
buis {{d_as}} {{b_beeld/2}} 0 {{d_as}} {{b_beeld/2}} {{l_beeld}} {{dia_p}} blauw
buis {{b_beeld-d_as}} {{b_beeld/2}} 0 {{b_beeld-d_as}} {{b_beeld/2}} {{l_beeld}} {{dia_p}} blauw
#end if
#if profiel ≡ 6
buis 60 60 0 60 60 240 12 rood
buis 60 {{b_beeld-60}} 0 60 {{b_beeld-60}} 240 12 rood
buis {{b_beeld-60}} 60 0 {{b_beeld-60}} 60 240 12 rood
buis {{b_beeld-60}} {{b_beeld-60}} 0 {{b_beeld-60}} {{b_beeld-60}} 240 12 rood
#end if
@end
# Interactie normaalkracht en moment
