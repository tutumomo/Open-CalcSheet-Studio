"Voorgespannen prefab betonpaal
'Vierkante paal · C45/55 · XC4 · Y1860 · centrische voorspanning
# Paalspecificatie
@select profiel "Schacht en strengen"
  220 × 220 mm · 4 × Ø9.3 = 1
  250 × 250 mm · 5 × Ø9.3 = 2
  250 × 250 mm · 4 × Ø9.3 = 3
  290 × 290 mm · 6 × Ø9.3 = 4
  290 × 290 mm · 5 × Ø9.3 = 5
  290 × 290 mm · 5 × Ø12.5 · kop 4 Ø12 = 6
@end
L_in = ?{0}*(m)', paallengte (0 gebruikt de profiellengte)'
#hide
#if profiel ≡ 1
b = 220 mm
n_p = 4
L_ref = 18.5 m
F_str = 65 kN
φ = 1.5953
ε_cs = 0.00021
r_rel = 0.0318
e_tr = 0 m
M_Rd = 26.04 kN*m
#end if
#if profiel ≡ 2
b = 250 mm
n_p = 5
L_ref = 21.5 m
F_str = 71 kN
φ = 1.5392
ε_cs = 0.00019
r_rel = 0.0417
e_tr = 0.75 m
M_Rd = 37.62 kN*m
#end if
#if profiel ≡ 3
b = 250 mm
n_p = 4
L_ref = 19 m
F_str = 71 kN
φ = 1.5392
ε_cs = 0.00019
r_rel = 0.0424
e_tr = 0 m
M_Rd = 31.55 kN*m
#end if
#if profiel ≡ 4
b = 290 mm
n_p = 6
L_ref = 21.5 m
F_str = 71 kN
φ = 1.4751
ε_cs = 0.00016
r_rel = 0.0421
e_tr = 0.75 m
M_Rd = 53.98 kN*m
#end if
#if profiel ≡ 5
b = 290 mm
n_p = 5
L_ref = 18.5 m
F_str = 71 kN
φ = 1.4751
ε_cs = 0.00016
r_rel = 0.0426
e_tr = 0 m
M_Rd = 46.64 kN*m
#end if
#if profiel ≡ 6
b = 290 mm
n_p = 5
L_ref = 26 m
F_str = 125 kN
φ = 1.4751
ε_cs = 0.00016
r_rel = 0.0386
e_tr = 0.75 m
M_Rd = 73.82 kN*m
#end if
#show
L = if(L_in ≡ 0 m; L_ref; L_in)
#if L > 0 m
# Doorsnede en materiaal
A_c = b^2 - 529 mm^2', bruto oppervlak met vier afgeschuinde hoeken'
O_c = 4*b - 27 mm
A_p = n_p*if(profiel ≡ 6; 93; 52)*mm^2
A_n = A_c - A_p
W_x = b^3/6
h_0 = 2*A_c/O_c
f_ck = 45 N/mm^2
f_cki = 25 N/mm^2
E_c = 36283 N/mm^2
E_ci = 31476 N/mm^2
E_p = 195000 N/mm^2
# Voorspanning en verliezen
F_mal = n_p*F_str
σ_max = F_mal/A_p
Δ_el = E_p*F_mal/(A_n*E_ci)
σ_init = σ_max - Δ_el
σ_ci = -σ_init*A_p/A_n
ε_cc = -φ*σ_ci/E_c
Δ_rel = r_rel*σ_init
Δ_lang = (ε_cs*E_p + 0.8*Δ_rel - (E_p/E_c)*φ*σ_ci)/(1 + E_p/E_c*A_p/A_n*(1+0.8*φ))
σ_werk = σ_init - Δ_lang
P_eff = σ_werk*A_p
σ_cw = -P_eff/A_n
# Transport en hijsen
q_g = A_c*24 kN/m^3
a_h = 0.207*L
a_t = a_h - e_tr
#if min(a_t; L/2-a_h-e_tr) > 0 m
M_stat_t = q_g*a_t^2/2
M_tr = 1.6*M_stat_t
M_stat_h = q_g*a_h^2/2
M_h = 1.2*M_stat_h
M_Rk = W_x*(4.94 N/mm^2 - σ_cw)
η_tr = M_tr/M_Rk
η_h = M_h/M_Rk
'Benutting voor transport en hijsen op basis van de karakteristieke momentgrens. Een waarde boven 1 overschrijdt deze grens.
# Centrische druk en buigweerstand
N_Rd = (f_ck/1.5)*A_n - (σ_werk - 0.00175*E_p)*A_p
'Bij 1,75 ‰ betonrek wijkt de berekende centrische drukweerstand licht af van het eindpunt in de profieltabellen. Dit verschil is nog in onderzoek.
M_ref = M_Rd', UGT-schachtmoment bij N = 0 uit de profielberekening'
# Momentenlijn langs de paal
'Vrije uiteinden, gelijkmatig eigengewicht. Positief is veldbuiging. Bij transport op schommels draagt elk van de vier contactpunten een kwart van het dynamisch gewicht. Het referentiemoment M_tr hierboven betreft het buitenste steunpunt.
#hide
x_l = a_t/(1 m)
x_r = (a_h + e_tr)/(1 m)
l_m = L/(1 m)
q_m = q_g/(1 kN/m)
pos(x) = max(x; 0)
m_h(x) = 1.2*q_m*(-x^2/2 + l_m/2*(pos(x-a_h/(1 m))+pos(x-l_m+a_h/(1 m))))
m_t(x) = 1.6*q_m*(-x^2/2 + l_m/4*(pos(x-x_l)+pos(x-x_r)+pos(x-l_m+x_r)+pos(x-l_m+x_l)))
#show
M_veld_h = m_h(l_m/2)*kN*m
M_veld_t = m_t(l_m/2)*kN*m
M_lijn_t = max(abs(m_t(x_l));abs(m_t(x_r));abs(m_t(l_m/2));abs(m_t(min(x_r;max(x_l;l_m/4)))))*kN*m
η_lijn_t = M_lijn_t/M_Rk
#hide
s_x(x) = 30 + 540*x/l_m
#show
#for fase = 1 : 2
#if fase ≡ 1
# Transport · momenten en dwarskrachten
#else
# Hijsen · momenten en dwarskrachten
#end if
#hide
f_dyn = if(fase ≡ 1; 1.6; 1.2)
e_contact = if(fase ≡ 1; e_tr/(1 m); 0)
a_links = 0.207*l_m-e_contact
a_rechts = 0.207*l_m+e_contact
x_p(j) = if(j ≡ 0; 0; if(j ≡ 1; a_links; if(j ≡ 2; a_rechts; if(j ≡ 3; l_m-a_rechts; if(j ≡ 4; l_m-a_links; l_m)))))
m_f(x) = if(fase ≡ 1; m_t(x); m_h(x))
q_f = f_dyn*q_m
r_f = q_f*l_m/4
v_f(x;j) = j*r_f-q_f*x
m_s = max(abs(m_f(a_links));abs(m_f(a_rechts));abs(m_f(l_m/2));abs(m_f(min(a_rechts;max(a_links;l_m/4)))))
v_s = max(abs(v_f(a_links;0));abs(v_f(a_links;1));abs(v_f(a_rechts;1));abs(v_f(a_rechts;2)))
y_m(v) = 88+44*v/m_s
y_v(v) = 238-40*v/v_s
#show
'<svg class="dxf" viewBox="0 0 600 322" style="width:100%;font-size:12px" xmlns="http://www.w3.org/2000/svg">
'<text x="30" y="18">M [kNm] · positieve veldmomenten onder de as</text>
'<text x="30" y="178">V [kN] · positief boven de as</text>
#for j = 0 : 4
#hide
x_a = x_p(j)
x_b = x_p(j+1)
v_a = v_f(x_a;j)
v_b = v_f(x_b;j)
#show
#if x_b > x_a
'<path d="M's_x(x_a)' 88 L's_x(x_a)' 'y_m(m_f(x_a))' Q's_x((x_a+x_b)/2)' 'y_m(m_f(x_a)+v_a*(x_b-x_a)/2)' 's_x(x_b)' 'y_m(m_f(x_b))' L's_x(x_b)' 88 Z" fill="#d4e4f3"/>
'<path d="M's_x(x_a)' 'y_m(m_f(x_a))' Q's_x((x_a+x_b)/2)' 'y_m(m_f(x_a)+v_a*(x_b-x_a)/2)' 's_x(x_b)' 'y_m(m_f(x_b))'" fill="none" stroke="#25597c" stroke-width="1.8"/>
'<path d="M's_x(x_a)' 238 L's_x(x_a)' 'y_v(v_a)' L's_x(x_b)' 'y_v(v_b)' L's_x(x_b)' 238 Z" fill="#d2eae3"/>
'<path d="M's_x(x_a)' 'y_v(v_a)' L's_x(x_b)' 'y_v(v_b)'" stroke="#1f6754" fill="none" stroke-width="1.8"/>
#end if
#if j < 4
'<line x1="'s_x(x_b)'" x2="'s_x(x_b)'" y1="'y_v(v_b)'" y2="'y_v(v_b+r_f)'" stroke="#1f6754" stroke-width="1.8"/>
#end if
#loop
'<path d="M30 88 H570 M30 238 H570" stroke="#495766" fill="none"/>
#for j = 0 : 2
#hide
x_merk = if(j ≡ 0; a_links; if(j ≡ 1; l_m/2; l_m-a_links))
#show
'<text x="'s_x(x_merk)'" y="'y_m(m_f(x_merk)/2)+4'" text-anchor="middle" fill="#153b5a">'if(j ≡ 1; "+"; "−")'</text>
#loop
'<text x="30" y="151">Buitenste steunpunt 'round(m_f(a_links)*100)/100' kNm · middenveld +'round(m_f(l_m/2)*100)/100' kNm</text>
'<text x="'s_x(a_rechts+(l_m/2-a_rechts)/4)'" y="228" text-anchor="middle">+</text>
'<text x="'s_x(l_m-a_rechts-(l_m/2-a_rechts)/4)'" y="252" text-anchor="middle">−</text>
'<text x="30" y="300">V maximaal ±'round(v_s*100)/100' kN</text>
'<text x="570" y="300" text-anchor="end">x = 0 … 'l_m' m</text>
'</svg>
#loop
# Normaalkracht door voorspanning
'N is positief bij trek. Na de voorspanverliezen trekken de strengen aan het beton. In een vrij opgelegde paal zonder uitwendige axiale belasting zijn de trek in het staal en de druk in het beton in evenwicht.
N_staal = P_eff
N_beton = -P_eff
N_som = N_staal + N_beton
'De lijn toont het schachtdeel met volledig overgedragen voorspanning. Het verloop in de overdrachtszones bij kop en voet vraagt de overdrachtslengte van de strengen.
'<svg class="dxf" viewBox="0 0 600 145" style="width:100%;font-size:12px" xmlns="http://www.w3.org/2000/svg">
'<rect x="30" y="22" width="540" height="42" fill="#d4e4f3"/>
'<rect x="30" y="64" width="540" height="42" fill="#f5dfd4"/>
'<path d="M30 22 H570" fill="none" stroke="#25597c" stroke-width="2"/>
'<path d="M30 106 H570" fill="none" stroke="#98522f" stroke-width="2"/>
'<path d="M30 64 H570" fill="none" stroke="#394755" stroke-dasharray="5 3"/>
'<text x="42" y="46">+ 'round(N_staal/(1 kN)*10)/10' kN · strengen</text>
'<text x="42" y="90">− 'round(-N_beton/(1 kN)*10)/10' kN · beton</text>
'<text x="570" y="137" text-anchor="end">Ontwikkelde schacht · gezamenlijke resultante 0 kN</text>
'</svg>
# Trekpaal · constructieve UGT-toets
'Trek positief invoeren. De krachten en momenten gelden in deze toets voor alle drie zones. De module interpoleert lineair op de trektak van de UGT-profieltabellen voor buiging om de x-as. De geotechnische uittrekweerstand vereist afzonderlijke grondgegevens.
T_Ed = ?{0}*(kN)', ontwerpwaarde centrische trek'
M_Ed = ?{0}*(kN*m)', bijkomend moment om x'
#if T_Ed ≥ 0 kN
#hide
t_req = T_Ed/(1 kN)
#if profiel ≡ 1
T_kop = 67 kN
M_kop = (if(t_req ≤ 9; 5.4 + (4.6 - 5.4)*(t_req - 0)/9; if(t_req ≤ 17; 4.6 + (3.9 - 4.6)*(t_req - 9)/8; if(t_req ≤ 25; 3.9 + (3.1 - 3.9)*(t_req - 17)/8; if(t_req ≤ 34; 3.1 + (2.4 - 3.1)*(t_req - 25)/9; if(t_req ≤ 42; 2.4 + (1.6 - 2.4)*(t_req - 34)/8; if(t_req ≤ 51; 1.6 + (1.1 - 1.6)*(t_req - 42)/9; if(t_req ≤ 59; 1.1 + (0.5 - 1.1)*(t_req - 51)/8; if(t_req ≤ 67; 0.5 + (0.0 - 0.5)*(t_req - 59)/8; 0)))))))))*kN*m
T_over = 316 kN
M_over = (if(t_req ≤ 40; 26.0 + (23.3 - 26.0)*(t_req - 0)/40; if(t_req ≤ 79; 23.3 + (20.5 - 23.3)*(t_req - 40)/39; if(t_req ≤ 119; 20.5 + (17.6 - 20.5)*(t_req - 79)/40; if(t_req ≤ 158; 17.6 + (14.7 - 17.6)*(t_req - 119)/39; if(t_req ≤ 198; 14.7 + (11.5 - 14.7)*(t_req - 158)/40; if(t_req ≤ 237; 11.5 + (7.9 - 11.5)*(t_req - 198)/39; if(t_req ≤ 276; 7.9 + (3.9 - 7.9)*(t_req - 237)/39; if(t_req ≤ 316; 3.9 + (0.0 - 3.9)*(t_req - 276)/40; 0)))))))))*kN*m
T_schacht = 316 kN
M_schacht = (if(t_req ≤ 40; 26.0 + (23.3 - 26.0)*(t_req - 0)/40; if(t_req ≤ 79; 23.3 + (20.5 - 23.3)*(t_req - 40)/39; if(t_req ≤ 119; 20.5 + (17.6 - 20.5)*(t_req - 79)/40; if(t_req ≤ 158; 17.6 + (14.7 - 17.6)*(t_req - 119)/39; if(t_req ≤ 198; 14.7 + (11.5 - 14.7)*(t_req - 158)/40; if(t_req ≤ 237; 11.5 + (7.9 - 11.5)*(t_req - 198)/39; if(t_req ≤ 276; 7.9 + (3.9 - 7.9)*(t_req - 237)/39; if(t_req ≤ 316; 3.9 + (0.0 - 3.9)*(t_req - 276)/40; 0)))))))))*kN*m
#end if
#if profiel ≡ 2
T_kop = 84 kN
M_kop = (if(t_req ≤ 11; 7.2 + (6.1 - 7.2)*(t_req - 0)/11; if(t_req ≤ 21; 6.1 + (5.1 - 6.1)*(t_req - 11)/10; if(t_req ≤ 32; 5.1 + (4.0 - 5.1)*(t_req - 21)/11; if(t_req ≤ 42; 4.0 + (3.0 - 4.0)*(t_req - 32)/10; if(t_req ≤ 53; 3.0 + (2.0 - 3.0)*(t_req - 42)/11; if(t_req ≤ 63; 2.0 + (1.3 - 2.0)*(t_req - 53)/10; if(t_req ≤ 74; 1.3 + (0.6 - 1.3)*(t_req - 63)/11; if(t_req ≤ 84; 0.6 + (0.0 - 0.6)*(t_req - 74)/10; 0)))))))))*kN*m
T_over = 394 kN
M_over = (if(t_req ≤ 50; 37.6 + (33.7 - 37.6)*(t_req - 0)/50; if(t_req ≤ 99; 33.7 + (29.6 - 33.7)*(t_req - 50)/49; if(t_req ≤ 148; 29.6 + (25.4 - 29.6)*(t_req - 99)/49; if(t_req ≤ 198; 25.4 + (21.1 - 25.4)*(t_req - 148)/50; if(t_req ≤ 247; 21.1 + (16.5 - 21.1)*(t_req - 198)/49; if(t_req ≤ 295; 16.5 + (11.3 - 16.5)*(t_req - 247)/48; if(t_req ≤ 345; 11.3 + (5.5 - 11.3)*(t_req - 295)/50; if(t_req ≤ 394; 5.5 + (0.0 - 5.5)*(t_req - 345)/49; 0)))))))))*kN*m
T_schacht = 394 kN
M_schacht = (if(t_req ≤ 50; 37.6 + (33.7 - 37.6)*(t_req - 0)/50; if(t_req ≤ 99; 33.7 + (29.6 - 33.7)*(t_req - 50)/49; if(t_req ≤ 148; 29.6 + (25.4 - 29.6)*(t_req - 99)/49; if(t_req ≤ 198; 25.4 + (21.1 - 25.4)*(t_req - 148)/50; if(t_req ≤ 247; 21.1 + (16.5 - 21.1)*(t_req - 198)/49; if(t_req ≤ 295; 16.5 + (11.3 - 16.5)*(t_req - 247)/48; if(t_req ≤ 345; 11.3 + (5.5 - 11.3)*(t_req - 295)/50; if(t_req ≤ 394; 5.5 + (0.0 - 5.5)*(t_req - 345)/49; 0)))))))))*kN*m
#end if
#if profiel ≡ 3
T_kop = 67 kN
M_kop = (if(t_req ≤ 9; 6.3 + (5.5 - 6.3)*(t_req - 0)/9; if(t_req ≤ 17; 5.5 + (4.6 - 5.5)*(t_req - 9)/8; if(t_req ≤ 26; 4.6 + (3.7 - 4.6)*(t_req - 17)/9; if(t_req ≤ 34; 3.7 + (2.8 - 3.7)*(t_req - 26)/8; if(t_req ≤ 42; 2.8 + (2.0 - 2.8)*(t_req - 34)/8; if(t_req ≤ 51; 2.0 + (1.3 - 2.0)*(t_req - 42)/9; if(t_req ≤ 59; 1.3 + (0.6 - 1.3)*(t_req - 51)/8; if(t_req ≤ 67; 0.6 + (0.0 - 0.6)*(t_req - 59)/8; 0)))))))))*kN*m
T_over = 316 kN
M_over = (if(t_req ≤ 40; 31.6 + (28.2 - 31.6)*(t_req - 0)/40; if(t_req ≤ 79; 28.2 + (24.8 - 28.2)*(t_req - 40)/39; if(t_req ≤ 119; 24.8 + (21.3 - 24.8)*(t_req - 79)/40; if(t_req ≤ 158; 21.3 + (17.6 - 21.3)*(t_req - 119)/39; if(t_req ≤ 197; 17.6 + (13.6 - 17.6)*(t_req - 158)/39; if(t_req ≤ 237; 13.6 + (9.1 - 13.6)*(t_req - 197)/40; if(t_req ≤ 276; 9.1 + (4.5 - 9.1)*(t_req - 237)/39; if(t_req ≤ 316; 4.5 + (0.0 - 4.5)*(t_req - 276)/40; 0)))))))))*kN*m
T_schacht = 316 kN
M_schacht = (if(t_req ≤ 40; 31.6 + (28.2 - 31.6)*(t_req - 0)/40; if(t_req ≤ 79; 28.2 + (24.8 - 28.2)*(t_req - 40)/39; if(t_req ≤ 119; 24.8 + (21.3 - 24.8)*(t_req - 79)/40; if(t_req ≤ 158; 21.3 + (17.6 - 21.3)*(t_req - 119)/39; if(t_req ≤ 197; 17.6 + (13.6 - 17.6)*(t_req - 158)/39; if(t_req ≤ 237; 13.6 + (9.1 - 13.6)*(t_req - 197)/40; if(t_req ≤ 276; 9.1 + (4.5 - 9.1)*(t_req - 237)/39; if(t_req ≤ 316; 4.5 + (0.0 - 4.5)*(t_req - 276)/40; 0)))))))))*kN*m
#end if
#if profiel ≡ 4
T_kop = 100 kN
M_kop = (if(t_req ≤ 13; 9.5 + (8.1 - 9.5)*(t_req - 0)/13; if(t_req ≤ 25; 8.1 + (6.6 - 8.1)*(t_req - 13)/12; if(t_req ≤ 38; 6.6 + (5.2 - 6.6)*(t_req - 25)/13; if(t_req ≤ 51; 5.2 + (3.7 - 5.2)*(t_req - 38)/13; if(t_req ≤ 63; 3.7 + (2.5 - 3.7)*(t_req - 51)/12; if(t_req ≤ 76; 2.5 + (1.6 - 2.5)*(t_req - 63)/13; if(t_req ≤ 88; 1.6 + (0.8 - 1.6)*(t_req - 76)/12; if(t_req ≤ 100; 0.8 + (0.0 - 0.8)*(t_req - 88)/12; 0)))))))))*kN*m
T_over = 473 kN
M_over = (if(t_req ≤ 60; 54.0 + (48.3 - 54.0)*(t_req - 0)/60; if(t_req ≤ 119; 48.3 + (42.4 - 48.3)*(t_req - 60)/59; if(t_req ≤ 178; 42.4 + (36.2 - 42.4)*(t_req - 119)/59; if(t_req ≤ 237; 36.2 + (29.9 - 36.2)*(t_req - 178)/59; if(t_req ≤ 296; 29.9 + (23.2 - 29.9)*(t_req - 237)/59; if(t_req ≤ 355; 23.2 + (15.6 - 23.2)*(t_req - 296)/59; if(t_req ≤ 414; 15.6 + (7.6 - 15.6)*(t_req - 355)/59; if(t_req ≤ 473; 7.6 + (0.0 - 7.6)*(t_req - 414)/59; 0)))))))))*kN*m
T_schacht = 473 kN
M_schacht = (if(t_req ≤ 60; 54.0 + (48.3 - 54.0)*(t_req - 0)/60; if(t_req ≤ 119; 48.3 + (42.4 - 48.3)*(t_req - 60)/59; if(t_req ≤ 178; 42.4 + (36.2 - 42.4)*(t_req - 119)/59; if(t_req ≤ 237; 36.2 + (29.9 - 36.2)*(t_req - 178)/59; if(t_req ≤ 296; 29.9 + (23.2 - 29.9)*(t_req - 237)/59; if(t_req ≤ 355; 23.2 + (15.6 - 23.2)*(t_req - 296)/59; if(t_req ≤ 414; 15.6 + (7.6 - 15.6)*(t_req - 355)/59; if(t_req ≤ 473; 7.6 + (0.0 - 7.6)*(t_req - 414)/59; 0)))))))))*kN*m
#end if
#if profiel ≡ 5
T_kop = 84 kN
M_kop = (if(t_req ≤ 11; 8.6 + (7.4 - 8.6)*(t_req - 0)/11; if(t_req ≤ 21; 7.4 + (6.1 - 7.4)*(t_req - 11)/10; if(t_req ≤ 32; 6.1 + (4.8 - 6.1)*(t_req - 21)/11; if(t_req ≤ 42; 4.8 + (3.5 - 4.8)*(t_req - 32)/10; if(t_req ≤ 53; 3.5 + (2.4 - 3.5)*(t_req - 42)/11; if(t_req ≤ 63; 2.4 + (1.6 - 2.4)*(t_req - 53)/10; if(t_req ≤ 74; 1.6 + (0.8 - 1.6)*(t_req - 63)/11; if(t_req ≤ 84; 0.8 + (0.0 - 0.8)*(t_req - 74)/10; 0)))))))))*kN*m
T_over = 394 kN
M_over = (if(t_req ≤ 50; 46.6 + (41.6 - 46.6)*(t_req - 0)/50; if(t_req ≤ 99; 41.6 + (36.5 - 41.6)*(t_req - 50)/49; if(t_req ≤ 148; 36.5 + (31.2 - 36.5)*(t_req - 99)/49; if(t_req ≤ 197; 31.2 + (25.8 - 31.2)*(t_req - 148)/49; if(t_req ≤ 246; 25.8 + (19.7 - 25.8)*(t_req - 197)/49; if(t_req ≤ 296; 19.7 + (13.2 - 19.7)*(t_req - 246)/50; if(t_req ≤ 346; 13.2 + (6.4 - 13.2)*(t_req - 296)/50; if(t_req ≤ 394; 6.4 + (0.0 - 6.4)*(t_req - 346)/48; 0)))))))))*kN*m
T_schacht = 394 kN
M_schacht = (if(t_req ≤ 50; 46.6 + (41.6 - 46.6)*(t_req - 0)/50; if(t_req ≤ 99; 41.6 + (36.5 - 41.6)*(t_req - 50)/49; if(t_req ≤ 148; 36.5 + (31.2 - 36.5)*(t_req - 99)/49; if(t_req ≤ 197; 31.2 + (25.8 - 31.2)*(t_req - 148)/49; if(t_req ≤ 246; 25.8 + (19.7 - 25.8)*(t_req - 197)/49; if(t_req ≤ 296; 19.7 + (13.2 - 19.7)*(t_req - 246)/50; if(t_req ≤ 346; 13.2 + (6.4 - 13.2)*(t_req - 296)/50; if(t_req ≤ 394; 6.4 + (0.0 - 6.4)*(t_req - 346)/48; 0)))))))))*kN*m
#end if
#if profiel ≡ 6
T_kop = 222 kN
M_kop = (if(t_req ≤ 28; 20.8 + (17.9 - 20.8)*(t_req - 0)/28; if(t_req ≤ 56; 17.9 + (14.9 - 17.9)*(t_req - 28)/28; if(t_req ≤ 84; 14.9 + (11.9 - 14.9)*(t_req - 56)/28; if(t_req ≤ 111; 11.9 + (8.9 - 11.9)*(t_req - 84)/27; if(t_req ≤ 139; 8.9 + (6.3 - 8.9)*(t_req - 111)/28; if(t_req ≤ 167; 6.3 + (4.2 - 6.3)*(t_req - 139)/28; if(t_req ≤ 195; 4.2 + (2.1 - 4.2)*(t_req - 167)/28; if(t_req ≤ 222; 2.1 + (0.0 - 2.1)*(t_req - 195)/27; 0)))))))))*kN*m
T_over = 902 kN
M_over = (if(t_req ≤ 113; 90.1 + (81.2 - 90.1)*(t_req - 0)/113; if(t_req ≤ 226; 81.2 + (71.5 - 81.2)*(t_req - 113)/113; if(t_req ≤ 339; 71.5 + (61.2 - 71.5)*(t_req - 226)/113; if(t_req ≤ 452; 61.2 + (50.6 - 61.2)*(t_req - 339)/113; if(t_req ≤ 564; 50.6 + (39.7 - 50.6)*(t_req - 452)/112; if(t_req ≤ 677; 39.7 + (28.6 - 39.7)*(t_req - 564)/113; if(t_req ≤ 790; 28.6 + (14.7 - 28.6)*(t_req - 677)/113; if(t_req ≤ 902; 14.7 + (0.0 - 14.7)*(t_req - 790)/112; 0)))))))))*kN*m
T_schacht = 706 kN
M_schacht = (if(t_req ≤ 89; 73.8 + (66.7 - 73.8)*(t_req - 0)/89; if(t_req ≤ 177; 66.7 + (58.8 - 66.7)*(t_req - 89)/88; if(t_req ≤ 265; 58.8 + (50.4 - 58.8)*(t_req - 177)/88; if(t_req ≤ 353; 50.4 + (41.6 - 50.4)*(t_req - 265)/88; if(t_req ≤ 441; 41.6 + (32.6 - 41.6)*(t_req - 353)/88; if(t_req ≤ 529; 32.6 + (22.9 - 32.6)*(t_req - 441)/88; if(t_req ≤ 618; 22.9 + (11.4 - 22.9)*(t_req - 529)/89; if(t_req ≤ 706; 11.4 + (0.0 - 11.4)*(t_req - 618)/88; 0)))))))))*kN*m
#end if
#show
T_Rd = min(T_kop; T_over; T_schacht)
M_toel = min(M_kop; M_over; M_schacht)
η_trek = T_Ed/T_Rd
#if T_Ed > T_Rd
'Trekweerstand overschreden.
#else
#if abs(M_Ed) > M_toel
'Momentweerstand bij deze trekbelasting overschreden.
#else
'Belastingpunt ligt binnen de constructieve UGT-profielgrenzen.
#end if
#end if
'Projectie van de trekbelasting op de UGT-grens van de aansluiting. Buiten het diagram blijft de numerieke toets hierboven bepalend.
#hide
t_span = max(T_Ed; T_kop)/(1 kN)
#show
#if profiel ≡ 1
#hide
m_span = max(abs(M_Ed)/(1 kN*m); 5.4)
